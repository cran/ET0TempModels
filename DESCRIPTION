Package: ET0TempModels
Type: Package
Title: Evapotranspiration Estimation Using Temperature-Based Models
Version: 1.0.0
Authors@R: c(
    person("Ajay N.", "Satpute", role = "aut"),
    person("Samir", "Barman", email = "samir.igfri@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-8181-8346")),
